TitleFix.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
TitleFix.BorderSizePixel = 0
TitleFix.Parent = Title

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(1, -20, 0, 36)
ToggleBtn.Position = UDim2.new(0, 10, 0, 45)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
ToggleBtn.BorderSizePixel = 0
ToggleBtn.Text = "Start AFK Farm"
ToggleBtn.Font = Enum.Font.Gotham
ToggleBtn.TextSize = 14
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Parent = Frame
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -20, 0, 30)
Status.Position = UDim2.new(0, 10, 0, 90)
Status.BackgroundTransparency = 1
Status.Text = "Status: Stopped"
Status.Font = Enum.Font.Gotham
Status.TextSize = 12
Status.TextColor3 = Color3.fromRGB(160, 160, 170)
Status.TextXAlignment = Enum.TextXAlignment.Left
Status.Parent = Frame

ToggleBtn.MouseButton1Click:Connect(function()
    running = not running
    if running then
        ToggleBtn.Text = "Stop AFK Farm"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        Status.Text = "Status: Farming..."
        startFarm()
    else
        ToggleBtn.Text = "Start AFK Farm"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        Status.Text = "Status: Stopped"
    end
end)

local dragging, dragStart, startPos
Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
    end
end)
Title.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
